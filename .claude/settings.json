{
"extraKnownMarketplaces": { "gorzko-plugins": { "source": { "source": "github", "repo": "gorzko/claude-plugins" } } },
"enabledPlugins": { "delivery-pipeline@gorzko-plugins": true },
  "enabledMcpjsonServers": ["wikimedia-image-search", "youtube", "tavily"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npm install 2>/dev/null || true",
            "statusMessage": "Instalowanie zależności npm..."
          }
        ]
      }
    ]
  }
}
